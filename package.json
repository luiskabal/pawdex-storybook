{
  "name": "pawdex-storybook",
  "version": "1.1.0",
  "description": "A React UI library built with Atomic Design principles and Material UI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
